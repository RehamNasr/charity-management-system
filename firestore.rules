rules_version = '2';

// Foundation-level rules only. Business-module collections (cases, assistance, donors,
// donations, expenses, transactions, etc. — see docs/ARCHITECTURE.md §6/§8) are added as
// each module is implemented. Default posture is deny-all; nothing is opened up "just in case".
//
// There is no role-based access control: every signed-in user has identical read/write access
// (docs/ARCHITECTURE.md §3). The only distinction the rules make is signed-in vs. signed-out.
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // Users can read any profile once signed in; profile documents are never written directly by
    // clients.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create, update, delete: if false;
    }

    // Lookup collections (docs/ARCHITECTURE.md §6.5) — read/write for any signed-in user.
    match /governorates/{id} {
      allow read, write: if isSignedIn();
    }
    match /cities/{id} {
      allow read, write: if isSignedIn();
    }
    match /villages/{id} {
      allow read, write: if isSignedIn();
    }
    match /caseTypes/{id} {
      allow read, write: if isSignedIn();
    }

    // Case-number sequence counter (docs/ARCHITECTURE.md §6 — "Firestore counter document, not
    // client Date.now()"). Only ever touched inside the case-creation transaction.
    match /counters/{counterId} {
      allow read, write: if isSignedIn();
    }

    // Cases (docs/ARCHITECTURE.md §3/§6/§8) — any signed-in user has full read/create/update.
    match /cases/{caseId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn() &&
                       request.resource.data.isDeleted == false &&
                       request.resource.data.createdBy == request.auth.uid;

      allow update: if isSignedIn();

      // "Delete" from the UI is always a soft delete (an `update` that sets isDeleted) — hard
      // delete is out of scope for this module.
      allow delete: if false;

      // ID card images / supporting documents.
      match /attachments/{attachmentId} {
        allow read, create, update, delete: if isSignedIn();
      }
    }

    // Social Research Visits — any signed-in user has full read/create/update.
    match /caseVisits/{visitId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
                       request.resource.data.isDeleted == false &&
                       request.resource.data.createdBy == request.auth.uid;
      allow update: if isSignedIn();
      allow delete: if false;

      match /attachments/{attachmentId} {
        allow read, create, update, delete: if isSignedIn();
      }

      match /history/{historyId} {
        allow read, create: if isSignedIn();
        allow update, delete: if false;
      }
    }

    // Donors, donations, expenses (Phase 1 reports/dashboard) — any signed-in user has full
    // read/create/update; delete is always a soft delete via update.
    match /donors/{donorId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.isDeleted == false;
      allow update: if isSignedIn();
      allow delete: if false;
    }
    match /donations/{donationId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.isDeleted == false;
      allow update: if isSignedIn();
      allow delete: if false;
    }
    match /expenses/{expenseId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.isDeleted == false;
      allow update: if isSignedIn();
      allow delete: if false;
    }
    match /assistance/{assistanceId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.isDeleted == false;
      allow update: if isSignedIn();
      allow delete: if false;
    }

    // Default deny for every other collection until its module is implemented.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
