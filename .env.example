# Cloudinary (unsigned client-side uploads for visit attachments).
# This app has no backend, so it can only use Cloudinary's *unsigned* upload flow — never put
# your API key or API secret here or anywhere else in this codebase; an unsigned upload preset
# is the only credential this client is allowed to hold.
#   1. Cloud name: shown at the top of https://console.cloudinary.com (also in every asset URL).
#   2. Upload preset: Settings -> Upload -> Upload presets -> Add upload preset ->
#      Signing Mode: Unsigned. Optionally restrict allowed formats/folder there too.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# App metadata
VITE_APP_NAME="نظام إدارة الجمعية الخيرية"
VITE_APP_ENV=development